---
import { Icon } from 'astro-icon/components';

import Layout from '~/layouts/PageLayout.astro';
import KataCard from '~/components/catalog/KataCard.astro';
import { fetchKatas } from '~/utils/katas';

const katas = await fetchKatas();
const languages = Array.from(new Set(katas.flatMap((kata) => kata.languages))).sort();
const topics = Array.from(new Set(katas.flatMap((kata) => kata.topics))).sort();

const metadata = {
  title: 'Kata catalog',
  description: 'All coding katas and refactoring exercises discovered from katas/*/README.md.',
};
---

<Layout metadata={metadata}>
  <section class="border-b border-slate-200 bg-white py-14 dark:border-slate-800 dark:bg-slate-950">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <p class="mb-4 inline-flex items-center gap-2 rounded-full bg-emerald-50 px-3 py-1 text-sm font-medium text-emerald-700 dark:bg-emerald-950 dark:text-emerald-200">
          <Icon name="tabler:list-details" class="h-4 w-4" />
          Markdown-backed catalog
        </p>
        <h1 class="text-4xl font-bold tracking-tight text-slate-950 dark:text-white sm:text-5xl">Kata catalog</h1>
        <p class="mt-5 text-lg leading-8 text-slate-600 dark:text-slate-300">
          Each entry is generated from a top-level folder in `katas/`. The README in that folder is both the source
          documentation and the rendered detail page.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-slate-50 py-10 dark:bg-slate-900/60">
    <div class="mx-auto grid max-w-7xl gap-6 px-4 sm:px-6 lg:grid-cols-[18rem_minmax(0,1fr)] lg:px-8">
      <aside class="rounded-lg border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-950">
        <h2 class="text-sm font-semibold uppercase tracking-normal text-slate-500 dark:text-slate-400">Facets</h2>
        <div class="mt-5">
          <h3 class="font-semibold text-slate-950 dark:text-white">Languages</h3>
          <div class="mt-3 flex flex-wrap gap-2" data-kata-facets-group="language">
            {
              languages.map((language) => (
                <button
                  type="button"
                  aria-pressed="false"
                  data-kata-facet-type="language"
                  data-kata-facet-value={language}
                  class="rounded-full bg-slate-100 px-3 py-1 text-xs text-slate-700 transition hover:bg-slate-200 dark:bg-slate-800 dark:text-slate-200 dark:hover:bg-slate-700"
                >
                  {language}
                </button>
              ))
            }
          </div>
        </div>
        <div class="mt-6">
          <h3 class="font-semibold text-slate-950 dark:text-white">Topics</h3>
          <div class="mt-3 flex flex-wrap gap-2" data-kata-facets-group="topic">
            {
              topics.map((topic) => (
                <button
                  type="button"
                  aria-pressed="false"
                  data-kata-facet-type="topic"
                  data-kata-facet-value={topic}
                  class="rounded-full bg-amber-50 px-3 py-1 text-xs text-amber-700 transition hover:bg-amber-100 dark:bg-amber-950 dark:text-amber-200 dark:hover:bg-amber-900"
                >
                  {topic}
                </button>
              ))
            }
          </div>
        </div>
      </aside>

      <div class="grid gap-5 md:grid-cols-2" data-kata-catalog>
        {katas.map((kata) => <KataCard kata={kata} />)}
      </div>
    </div>
  </section>
</Layout>

<script>
  const initKataFacets = () => {
    const activeFacets = {
      language: new Set(),
      topic: new Set(),
    };

    const cards = Array.from(document.querySelectorAll('[data-kata-card]'));
    const facetButtons = Array.from(document.querySelectorAll('[data-kata-facet-type][data-kata-facet-value]'));

    const updateButtonStates = () => {
      facetButtons.forEach((button) => {
        if (!(button instanceof HTMLButtonElement)) return;

        const facetType = button.dataset.kataFacetType;
        const facetValue = button.dataset.kataFacetValue;
        if ((facetType !== 'language' && facetType !== 'topic') || !facetValue) return;

        const isActive = activeFacets[facetType].has(facetValue);
        button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        button.classList.toggle('ring-2', isActive);
        button.classList.toggle('ring-offset-1', isActive);
        button.classList.toggle('ring-blue-500', isActive && facetType === 'language');
        button.classList.toggle('ring-amber-500', isActive && facetType === 'topic');
      });
    };

    const updateCards = () => {
      cards.forEach((card) => {
        if (!(card instanceof HTMLElement)) return;

        const cardLanguages = (card.dataset.kataLanguages ?? '').split('|').filter(Boolean);
        const cardTopics = (card.dataset.kataTopics ?? '').split('|').filter(Boolean);

        const languageMatch =
          activeFacets.language.size === 0 || cardLanguages.some((language) => activeFacets.language.has(language));
        const topicMatch = activeFacets.topic.size === 0 || cardTopics.some((topic) => activeFacets.topic.has(topic));

        card.classList.toggle('hidden', !(languageMatch && topicMatch));
      });
    };

    facetButtons.forEach((button) => {
      if (!(button instanceof HTMLButtonElement)) return;

      button.onclick = () => {
        const facetType = button.dataset.kataFacetType;
        const facetValue = button.dataset.kataFacetValue;
        if ((facetType !== 'language' && facetType !== 'topic') || !facetValue) return;

        if (activeFacets[facetType].has(facetValue)) {
          activeFacets[facetType].delete(facetValue);
        } else {
          activeFacets[facetType].add(facetValue);
        }

        updateButtonStates();
        updateCards();
      };
    });
  };

  document.addEventListener('astro:page-load', initKataFacets);
</script>
