---
import type { Kata } from '~/utils/katas';

interface Props {
  kata: Kata;
}

const { kata } = Astro.props;
---

<article
  class="group relative rounded-lg border border-gray-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md dark:border-slate-800 dark:bg-slate-900"
  data-kata-card
  data-kata-languages={kata.languages.join('|')}
  data-kata-topics={kata.topics.join('|')}
>
  <div class="mb-4 flex flex-wrap gap-2">
    {
      kata.languages
        .slice(0, 4)
        .map((language) => (
          <span class="rounded-full bg-blue-50 px-3 py-1 text-xs font-medium text-blue-700 dark:bg-blue-950 dark:text-blue-200">
            {language}
          </span>
        ))
    }
  </div>

  <h2 class="text-xl font-semibold tracking-tight text-slate-950 dark:text-white">
    <a class="after:absolute after:inset-0" href={kata.href}>{kata.title}</a>
  </h2>

  <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-300">{kata.summary}</p>

  <div class="mt-5 flex flex-wrap gap-2">
    {kata.topics.map((topic) => <span class="text-xs text-slate-500 dark:text-slate-400">#{topic}</span>)}
  </div>

  <div class="mt-6 flex items-center justify-between text-sm">
    <span class="font-mono text-xs text-slate-500 dark:text-slate-400">{kata.repositoryPath}</span>
    <span class="font-medium text-blue-700 group-hover:text-blue-800 dark:text-blue-300">Open</span>
  </div>
</article>
