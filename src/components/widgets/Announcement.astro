---
import { getPermalink } from '~/utils/permalinks';
---

<div
  class="text-sm bg-slate-900 text-slate-300 dark:bg-transparent dark:border-b dark:border-slate-800 dark:text-slate-400 hidden md:flex gap-2 overflow-hidden px-3 py-2 relative text-ellipsis whitespace-nowrap"
>
  <span
    class="bg-white/20 dark:bg-slate-700 text-slate-100 dark:text-slate-300 font-semibold px-1 py-0.5 text-xs inline-block"
    >CATALOG</span
  >
  <a href={getPermalink('/katas')} class="text-slate-300 hover:underline dark:text-slate-400 font-medium"
    >Browse the consolidated kata list</a
  >
  <a
    target="_blank"
    rel="noopener"
    class="ltr:ml-auto rtl:mr-auto ml-auto text-slate-300 hover:underline dark:text-slate-400 font-medium"
    href="https://github.com/evilz/code-katas"
  >
    GitHub repository
  </a>
</div>
